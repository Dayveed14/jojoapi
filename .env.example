NODE_ENV=development
PORT=4000
# The exact address of the site (used for CORS, CSRF checks and email links). No trailing slash.
# In production: https://<your-site>.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Proxies in front of the API: 0 locally, 1 on Render, 2 when Vercel forwards /api to Render
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jojo
DB_PASSWORD=change-me
DB_NAME=jojo_market
# Hosted MySQL usually needs TLS:
DB_SSL=false
DB_SSL_CA=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# true in production (HTTPS). If API and site are on different sites (not subdomains), use SameSite=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFY_TTL_HOURS=48

# Cloudinary (avatar uploads now; receipts/sample photos later). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jojo-market

# Email via Resend (resend.com → API Keys). Leave RESEND_API_KEY blank to print emails in the terminal instead.
# MAIL_FROM must be on a domain you've verified in Resend — here, fixer.com.
RESEND_API_KEY=
MAIL_FROM=Jojo Market <jojomarket@fixer.com>
MAIL_REPLY_TO=

# Payments. Leave blank to run in bank-transfer mode (Jojo confirms each transfer in Admin → Payments).
# Paystack webhook URL to set in the Paystack dashboard: https://<your-domain>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Road distance for transport estimates. Leave blank to use straight-line distance × ROAD_FACTOR.
GOOGLE_MAPS_API_KEY=
ROAD_FACTOR=1.35

# Run background jobs (expire stale requests, send restock reminders) inside the API process.
# Turn off if you run `npm run jobs` from cron instead.
JOBS_ENABLED=true
